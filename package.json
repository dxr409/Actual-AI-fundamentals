{
  "name": "qairu-ai-platform",
  "version": "1.0.0",
  "description": "QAIRU AI Learning Platform — Interactive textbook for AI education",
  "main": "electron/main.js",
  "scripts": {
    "dev:web": "node server.cjs",
    "dev:vite": "vite",
    "build": "tsc && vite build",
    "build:electron": "npm run build && electron-builder",
    "preview": "vite preview",
    "backend": "python3 backend/main.py",
    "dev:full": "concurrently \"npm run backend\" \"npm run dev:web\"",
    "test": "vitest"
  },
  "dependencies": {
    "axios": "^1.7.7",
    "clsx": "^2.1.1",

    "d3": "^7.9.0",
    "i18next": "^23.14.0",
    "i18next-browser-languagedetector": "^8.0.0",
    "lucide-react": "^0.446.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.0.1",
    "react-router-dom": "^6.26.1",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.0",
    "electron": "^31.4.0",
    "electron-builder": "^24.13.3",
    "postcss": "^8.4.45",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.3",
    "vite": "^5.4.2",
    "vitest": "^2.0.5"
  },
  "build": {
    "appId": "kz.qairu.ai-platform",
    "productName": "QAIRU AI Platform",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*"
    ],
    "mac": {
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
